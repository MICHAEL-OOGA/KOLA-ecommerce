# =========================================================
# NOVA - Git Ignore Rules
# =========================================================

# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# Prisma generated client
server/src/generated/prisma/

# Build output
dist/
build/
coverage/

# Vite/cache output
.vite/
.cache/

# Postman local files / exports
.postman/
postman/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE settings
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx

# Temporary files
*.tmp
*.temp