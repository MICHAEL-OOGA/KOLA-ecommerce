PORT=5000
NODE_ENV=development

JWT_SECRET=replace-with-a-strong-secret
AUTH_SESSION_MINUTES=120
JWT_ISSUER=mini-ecommerce-api
JWT_AUDIENCE=mini-ecommerce-client
AUTH_COOKIE_SAME_SITE=lax
AUTH_MAX_ACTIVE_SESSIONS=5

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=

ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=

ORDER_PAYMENT_WINDOW_MINUTES=15
ORDER_EXPIRY_SWEEP_SECONDS=60
ORDER_EXPIRY_BATCH_SIZE=50

CSRF_SECRET=replace-with-a-different-strong-secret

CLIENT_URLS=http://localhost:5173,http://localhost:5174
TRUST_PROXY_HOPS=0
ENFORCE_HTTPS=false
API_RATE_LIMIT_MAX=600
MPESA_CALLBACK_RATE_LIMIT_MAX=300

PASSWORD_RESET_SECRET=replace-with-a-different-strong-secret
PASSWORD_RESET_MINUTES=15
PASSWORD_RESET_CLIENT_URL=http://localhost:5173
PASSWORD_RESET_DEV_EXPOSE_TOKEN=false

EMAIL_VERIFICATION_SECRET=replace-with-a-different-strong-secret
EMAIL_VERIFICATION_MINUTES=60
EMAIL_VERIFICATION_DEV_EXPOSE_TOKEN=false

SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=

AUDIT_HASH_SECRET=replace-with-a-different-strong-secret

SECURITY_CLEANUP_INTERVAL_MINUTES=60
AUTH_SESSION_RETENTION_DAYS=30
SECURITY_TOKEN_RETENTION_HOURS=24

DISPOSABLE_EMAIL_DOMAINS=kolsea.com