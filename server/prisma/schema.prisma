generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  VERIFYING
  SUCCESS
  FAILED
  CANCELLED
}

enum CallbackProcessingStatus {
  RECEIVED
  PROCESSED
  REJECTED
  UNMATCHED
  ERROR
}

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jwtId String @unique @db.VarChar(36)

  expiresAt DateTime
  revokedAt DateTime?

  revocationReason String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?

  requestedIpHash String? @db.VarChar(64)

  createdAt DateTime @default(now())

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
}

model User {
  id       String  @id @default(cuid())
  fullName String
  email    String  @unique
  phone    String?
  password String
  role     Role    @default(CUSTOMER)

  orders              Order[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int     @default(0)
  isActive    Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Order {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String

  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)

  idempotencyKey     String? @unique @db.VarChar(128)
  requestFingerprint String? @db.VarChar(64)

  items           OrderItem[]
  payment         Payment?
  paymentAttempts PaymentAttempt[]

  processingStartedAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  stockRestoredAt     DateTime?

  expiresAt DateTime?
  expiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, expiresAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method String        @default("MPESA")
  status PaymentStatus @default(PENDING)
  amount Decimal       @db.Decimal(10, 2)

  phoneNumber        String
  merchantRequestId  String?
  checkoutRequestId  String? @unique
  mpesaReceiptNumber String? @unique
  resultCode         String?
  resultDescription  String?

  verifiedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

model PaymentAttempt {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method String        @default("MPESA")
  status PaymentStatus @default(PENDING)
  amount Decimal       @db.Decimal(10, 2)

  phoneNumber      String
  accountReference String?

  merchantRequestId String? @unique
  checkoutRequestId String? @unique

  mpesaReceiptNumber String? @unique

  initiationResponseCode        String?
  initiationResponseDescription String?

  resultCode        String?
  resultDescription String?

  callbackReceivedAt DateTime?
  verifiedAt         DateTime?
  paidAt             DateTime?

  callbackEvents MpesaCallbackEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@index([status])
}

model MpesaCallbackEvent {
  id String @id @default(cuid())

  paymentAttemptId String?
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  eventKey String @unique

  merchantRequestId String?
  checkoutRequestId String?
  resultCode        String?

  payload Json

  processingStatus CallbackProcessingStatus @default(RECEIVED)
  errorMessage     String?
  sourceIp         String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([checkoutRequestId])
  @@index([processingStatus, receivedAt])
}
